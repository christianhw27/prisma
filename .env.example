# ==========================================
# PRISMA - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Supabase Database Configuration
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Cloudinary Media Storage (Foto & Video)
# Dapatkan dari Cloudinary Dashboard Console:
# - VITE_CLOUDINARY_CLOUD_NAME: Nama Cloud (Dashboard -> Cloud name)
# - VITE_CLOUDINARY_UPLOAD_PRESET: Unsigned Upload Preset (Settings -> Upload -> Upload presets -> Add upload preset -> Signing Mode: Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
